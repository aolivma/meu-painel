{
  "manifest_version": 3,
  "name": "Meu Painel",
  "version": "1.7.1",
  "description": "Página inicial com seus links favoritos em cards.",
  "homepage_url": "https://SEU-USUARIO.github.io/mylinks/",
  "minimum_chrome_version": "104",
  "permissions": ["storage", "favicon", "activeTab", "contextMenus"],
  "host_permissions": ["<all_urls>"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Adicionar a meus links",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  }
}
